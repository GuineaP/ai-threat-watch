---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { href } from '../../lib/routes';
import { readingTopics } from '../../lib/reading';
const guides=(await getCollection('guides')).sort((a,b)=>a.data.order-b.data.order);
---
<BaseLayout title="閱讀主題"><div class="wide"><header class="page-heading"><h1>從問題或題材找文章。</h1><p>生活問題幫你選起點；題材分類讓你繼續探索。</p></header><div class="guide-grid">{guides.map(g=><a class="guide-card" href={href('/guides/'+g.data.slug+'/')}><h2>{g.data.title}</h2><p>{g.data.summary}</p></a>)}</div><section class="section"><h2>按題材找案例</h2><div class="text-links">{readingTopics.map(t=><a href={href('/reports/anthropic-2026-09/cases/')+'?topic='+t.value}>{t.label}</a>)}</div></section></div></BaseLayout>

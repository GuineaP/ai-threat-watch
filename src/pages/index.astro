---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { allCases, caseTitle } from '../lib/content';
import { href, caseHref } from '../lib/routes';
import { reportId } from '../lib/reading';
const guides = (await getCollection('guides')).sort((a,b)=>a.data.order-b.data.order);
const entries = (await allCases()).filter(e=>e.data.report.report_id===reportId);
const first = entries.find(e=>e.data.slug==='gtg-54004')!;
---
<BaseLayout title="AI 已能做什麼，對台灣意味著什麼？">
  <section class="home-hero wide">
    <div class="hero-copy"><p class="eyebrow">給台灣讀者的 AI 風險導讀</p><h1>AI 已能做什麼，<br />對台灣意味著什麼？</h1><p class="lead">從報告記載的具體工作，看清人與 AI 的分工、已觀察到的成果，以及對台灣的風險推演。</p><div class="hero-actions"><a class="button primary" href="#questions">選一個你關心的問題 <span aria-hidden="true">↓</span></a><a class="text-link" href={href(`/reports/${reportId}/cases/`)}>查看全部 {entries.length} 篇案例 <span aria-hidden="true">↗</span></a></div></div>
    <aside class="reading-map" aria-label="本站的閱讀方式"><p class="eyebrow">從問題到理解</p><ol><li><span aria-hidden="true">01</span><div><strong>一個生活問題</strong><p>從你關心的事情開始。</p></div></li><li><span aria-hidden="true">02</span><div><strong>一件具體事件</strong><p>看清楚工具與人的分工。</p></div></li><li><span aria-hidden="true">03</span><div><strong>把問題帶回台灣</strong><p>分清案例記載與風險推演。</p></div></li></ol></aside>
  </section>
  <section class="section wide" id="questions"><div class="section-heading"><div><p class="eyebrow">從這裡開始</p><h2>你想先理解哪件事？</h2></div><p class="fine">不需要先懂技術名詞。</p></div><div class="guide-grid">{guides.map(g=><a class="guide-card" href={href(`/guides/${g.data.slug}/`)}><span class="guide-number" aria-hidden="true">0{g.data.order}</span><h3>{g.data.title}</h3><p>{g.data.summary}</p><span class="guide-action">開始閱讀 <span aria-hidden="true">→</span></span></a>)}</div></section>
  <section class="starter wide"><div><p class="eyebrow">第一次讀，從這篇開始</p><h2><a href={caseHref(reportId,first.data.slug)+'?guide=public-opinion'}>{caseTitle(first)}</a></h2><p>{first.data.summary_zh}</p><a class="text-link" href={caseHref(reportId,first.data.slug)+'?guide=public-opinion'}>讀這個案例 <span aria-hidden="true">→</span></a></div><div class="starter-question"><span aria-hidden="true">？</span><p>一套要求，<br />如何寫成五十種說法？</p></div></section>
  <section class="section wide home-context"><div><p class="eyebrow">把問題帶回台灣</p><h2>如果類似方法被用於台灣</h2></div><div><p>以下是編者的情境推演。若中國政府或受託單位使用類似工具，讓 AI 協助大量改寫訊息、整理人物資料、模仿文風與修改程式，這些工作可能如何改變台灣面對的風險？</p><p>各篇先說明來源記載，再獨立呈現編者觀點。部分案例已明確提到台灣，例如人物建檔與模擬目標；其他情境推演則不代表相關做法已用於台灣，也不代表攻擊已成功。</p><a href={href('/guides/')}>從四個問題繼續想 <span aria-hidden="true">→</span></a></div></section>
  <div class="wide provenance"><p>目前 {entries.length} 篇條目來自 Anthropic 的一份報告，含一篇內嵌補充案例。Anthropic 也是 Claude 的商業供應商；本站沒有獨立取得全部底層紀錄。篇數不是威脅發生率，也不代表 {entries.length} 次成功攻擊。</p><a href={href('/about/')}>認識來源與編者 <span aria-hidden="true">→</span></a></div>
</BaseLayout>

---
import BaseLayout from './BaseLayout.astro';
import { href } from '../lib/routes';
interface Props { title: string; eyebrow?: string; description?: string; }
const { title, eyebrow, description } = Astro.props;
---
<BaseLayout title={title} description={description}>
  <div class="reading-page"><a class="back-link" href={href('/')}>回首頁</a><header class="article-header">{eyebrow && <p class="eyebrow">{eyebrow}</p>}<h1>{title}</h1></header><div class="prose"><slot /></div></div>
</BaseLayout>
